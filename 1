#include <stdio.h>
#include <string.h>
#include <math.h>
#include <stdlib.h>

#define CHAR_SET_SIZE 128 // Assuming ASCII characters

int longestPalindrome(const char *s) {
    int freq[CHAR_SET_SIZE] = {0}; // Frequency array for characters
    int length = 0;
    int oddFound = 0;

    // Count the frequency of each character in the string
    for (int i = 0; s[i] != '\0'; i++) {
        freq[(int)s[i]]++;
    }

    // Iterate over the character frequencies
    for (int i = 0; i < CHAR_SET_SIZE; i++) {
        if (freq[i] % 2 == 0) {
            length += freq[i]; // If the frequency is even, add it
        } else {
            length += freq[i] - 1; // Add the largest even part
            oddFound = 1; // Mark that we found at least one odd frequency
        }
    }

    // If an odd frequency was found, we can place one odd character in the center
    if (oddFound) {
        length += 1;
    }

    return length;
}

int main() {
    char s[1000]; // Adjust size as needed
    scanf("%s", s);
    printf("%d\n", longestPalindrome(s));
    return 0;
}
